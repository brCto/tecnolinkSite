{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tecnolinkSite-http",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "tecnolinkSite/tecnolinkSite.csproj", "--launch-profile", "http"],
      "port": 5033
    },
    {
      "name": "tecnolinkSite-https",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "tecnolinkSite/tecnolinkSite.csproj", "--launch-profile", "https"],
      "port": 7112
    },
    {
      "name": "tecnolinkSite-wt",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "tecnolinkSite/tecnolinkSite.csproj", "--urls", "http://localhost:5199"],
      "port": 5199
    },
    {
      "name": "tecnolinkSite-watch",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["watch", "--project", "tecnolinkSite/tecnolinkSite.csproj", "run", "--urls", "http://localhost:5200"],
      "port": 5200
    }
  ]
}
