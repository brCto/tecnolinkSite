# Copia questo file in ".env" (stesso percorso) e compila i valori reali.
# Il file ".env" NON va condiviso o caricato su repository pubblici: contiene una password.

# --- Email (invio richieste dal form Contatti e dal Security Check) ---
# ATTENZIONE ALLA PORTA. Va usata la porta STARTTLS del provider, quasi sempre la 587.
# La 465 NON funziona: e' la porta dell'SSL "implicito" (la connessione parte gia'
# cifrata), e la classe con cui l'applicazione spedisce la posta non lo sa fare — sa
# fare solo STARTTLS, cioe' connettersi in chiaro e alzare la cifratura subito dopo.
# Con la 465 l'invio va in timeout, la richiesta del visitatore non arriva a nessuno e
# nei log resta soltanto "Invio email fallito".
#
# Con la posta Aruba l'host e' smtps.aruba.it e la porta giusta e' la 587.
# Verificate comunque i parametri esatti nel pannello email del vostro provider,
# cercando la porta indicata come "STARTTLS" o "TLS" (non "SSL").
SMTP_HOST=smtps.aruba.it
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USER=info@tecnolink.it
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_ADDRESS=info@tecnolink.it
SMTP_FROM_NAME=Sito Tecnolink
SMTP_TO_ADDRESS=info@tecnolink.it

# --- Analytics (opzionali: lasciare vuoti per tenerli spenti) ---
# I tag si caricano solo dopo l'accettazione sul banner dei cookie. Se questi
# restano vuoti il banner non compare nemmeno: non c'e' niente da consentire.
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
# LinkedIn: il Partner ID dell'Insight Tag e l'id numerico della conversione
# "Lead", tutti e due da Campaign Manager. Senza il secondo il tag conta le
# visite ma non le richieste inviate, e le campagne ottimizzano alla cieca.
LINKEDIN_PARTNER_ID=
LINKEDIN_LEAD_CONVERSION_ID=
