@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrEmpty(pageTitle)
        ? "Tecnolink | Sistemi Informatici &amp; Cybersecurity a Firenze"
        : $"{pageTitle} - Tecnolink";
    var description = ViewData["Description"] as string
        ?? "Tecnolink: da 20 anni sistemi informatici, sicurezza informatica e servizi di data science su misura per aziende e professionisti a Firenze. Scopri tecnoSHIELD.";
    var robots = ViewData["Robots"] as string ?? "index, follow";
    var canonicalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var ogImage = $"{Context.Request.Scheme}://{Context.Request.Host}/img/og-image.png";
    var ga4Id = Configuration["Analytics:GA4MeasurementId"] ?? "";
    var metaPixelId = Configuration["Analytics:MetaPixelId"] ?? "";
    var linkedInPartnerId = Configuration["Analytics:LinkedInPartnerId"] ?? "";
    var linkedInLeadConversionId = Configuration["Analytics:LinkedInLeadConversionId"] ?? "";
    var analyticsEnabled = !string.IsNullOrWhiteSpace(ga4Id)
        || !string.IsNullOrWhiteSpace(metaPixelId)
        || !string.IsNullOrWhiteSpace(linkedInPartnerId);

    // Landing mode: pagine di destinazione delle campagne a pagamento. Nascondono
    // menu e footer completo per non offrire vie d'uscita al traffico acquistato.
    // Le pagine restano comunque raggiungibili dal menu del sito generale.
    var isLanding = (ViewData["Landing"] as bool?) ?? false;
}
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@fullTitle</title>
    <meta name="description" content="@description" />
    <meta name="robots" content="@robots" />
    <link rel="canonical" href="@canonicalUrl" />
    <meta name="theme-color" content="#0a0f22" />
    <meta name="author" content="Tecnolink" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tecnolink" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:locale" content="it_IT" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@fullTitle" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@ogImage" />

    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" href="~/img/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="~/img/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" />
    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "ProfessionalService",
        "name": "Tecnolink",
        "description": "Sistemi informatici, helpdesk e assistenza tecnica, cybersicurezza e consulenza per aziende e professionisti di Firenze e zone limitrofe.",
        "image": "@ogImage",
        "url": "https://www.tecnolink.it",
        "telephone": "+39-055-617008",
        "email": "info@tecnolink.it",
        "priceRange": "$$",
        "address": {
            "@@type": "PostalAddress",
            "streetAddress": "Via Aretina 167/M",
            "addressLocality": "Firenze",
            "postalCode": "50136",
            "addressRegion": "FI",
            "addressCountry": "IT"
        },
        "areaServed": {
            "@@type": "GeoCircle",
            "geoMidpoint": {
                "@@type": "GeoCoordinates",
                "latitude": 43.7809,
                "longitude": 11.3149
            },
            "geoRadius": "30000"
        },
        "sameAs": []
    }
    </script>

    <script>
        window.TK_ANALYTICS = {
            ga4: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ga4Id)),
            metaPixel: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(metaPixelId)),
            linkedIn: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(linkedInPartnerId)),
            linkedInLeadConversionId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(linkedInLeadConversionId))
        };
    </script>
</head>
<body>
    <div class="tk-progress" id="tkProgress"></div>

    @if (analyticsEnabled)
    {
        <div class="tk-cookie-banner" id="tkCookieBanner">
            <p>Utilizziamo cookie di analisi per capire come viene usato il sito e migliorarlo. Puoi accettare o rifiutare in qualsiasi momento — trovi i dettagli nella <a asp-page="/Privacy">Privacy Policy</a>.</p>
            <div class="tk-cookie-actions">
                <button type="button" class="btn-tk btn-tk-outline" id="tkCookieDecline">Rifiuta</button>
                <button type="button" class="btn-tk btn-tk-dark" id="tkCookieAccept">Accetta</button>
            </div>
        </div>
    }
    <nav class="tk-nav @(isLanding ? "is-landing" : "")" id="tkNav">
        <div class="container-xl">
            @if (isLanding)
            {
                @* Landing: il logo non è un link verso l'esterno, resta sulla pagina. *@
                <span class="tk-brand">
                    <img src="~/img/logo-tecnolink-bianco-180x51.png" alt="Tecnolink" class="tk-logo" />
                </span>

                <div class="tk-nav-actions">
                    <a class="tk-nav-phone" href="tel:+390556617008"><i class="bi bi-telephone-fill"></i> 055 617008</a>
                    <a class="btn-tk btn-tk-primary" href="#contatti">Richiedi un'analisi</a>
                </div>
            }
            else
            {
                <a class="tk-brand" asp-area="" asp-page="/Index">
                    <img src="~/img/logo-tecnolink-bianco-180x51.png" alt="Tecnolink" class="tk-logo" />
                </a>

                <ul class="tk-nav-links">
                    <li><a asp-page="/Index" asp-fragment="home">Home</a></li>
                    <li><a asp-page="/Index" asp-fragment="servizi">Servizi</a></li>
                    <li><a asp-page="/Index" asp-fragment="tecnoshield">tecnoSHIELD</a></li>
                    <li><a asp-page="/Offerte/VulnerabilityAssessment">Check-up di sicurezza</a></li>
                    @* TEMP — accesso interno alle landing delle campagne (rimuovere prima del lancio degli ads) *@
                    <li><a asp-page="/Offerte/VulnerabilityAssessmentAziende">VA · Aziende</a></li>
                    <li><a asp-page="/Offerte/VulnerabilityAssessmentPrivati">VA · Privati</a></li>
                    <li><a asp-page="/Interno/MaterialiCampagne">Materiali</a></li>
                    @* /TEMP *@
                    <li><a asp-page="/Index" asp-fragment="chi-siamo">Chi siamo</a></li>
                    <li><a asp-page="/Index" asp-fragment="contatti">Contatti</a></li>
                    <li class="d-lg-none"><a class="btn-tk btn-tk-primary" asp-page="/Index" asp-fragment="contatti">Richiedi Consulenza</a></li>
                </ul>

                <div class="tk-nav-actions">
                    <a class="tk-nav-phone d-none d-lg-flex" href="tel:+390556617008"><i class="bi bi-telephone-fill"></i> 055 617008</a>
                    <a class="btn-tk btn-tk-primary" asp-page="/Index" asp-fragment="contatti">Richiedi Consulenza</a>
                    <button class="tk-nav-toggle" id="tkNavToggle" aria-label="Apri menu" aria-expanded="false"><i class="bi bi-list"></i></button>
                </div>
            }
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    @if (isLanding)
    {
        <footer class="tk-footer tk-footer-landing">
            <div class="container-xl">
                <div class="tk-footer-landing-grid">
                    <span class="tk-brand">
                        <img src="~/img/logo-tecnolink-bianco-180x51.png" alt="Tecnolink" class="tk-logo" />
                    </span>
                    <ul>
                        <li><i class="bi bi-geo-alt me-2"></i>Via Aretina 167/M, 50136 Firenze</li>
                        <li><i class="bi bi-telephone me-2"></i><a href="tel:+390556617008">055 617008</a></li>
                        <li><i class="bi bi-envelope me-2"></i><a href="mailto:info@tecnolink.it">info@tecnolink.it</a></li>
                    </ul>
                </div>
                <div class="tk-footer-bottom">
                    <span>&copy; @DateTime.Now.Year Tecnolink — P.IVA 04609110483</span>
                    <span><a asp-page="/Privacy">Privacy Policy</a></span>
                </div>
            </div>
        </footer>
    }
    else
    {
    <footer class="tk-footer">
        <div class="container-xl">
            <div class="tk-footer-grid">
                <div>
                    <a class="tk-brand" asp-area="" asp-page="/Index" style="margin-bottom:1rem;">
                        <img src="~/img/logo-tecnolink-bianco-180x51.png" alt="Tecnolink" class="tk-logo" />
                    </a>
                    <p>Da 20 anni progettiamo sistemi informatici e soluzioni di sicurezza su misura per aziende e professionisti di Firenze e delle zone limitrofe, senza chiedere ai nostri clienti di scegliere tra privacy e sicurezza.</p>
                    <div class="tk-social">
                        <a href="tel:+390556617008" aria-label="Telefono"><i class="bi bi-telephone"></i></a>
                        <a href="mailto:info@tecnolink.it" aria-label="Email"><i class="bi bi-envelope"></i></a>
                        <a href="https://www.linkedin.com" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>
                <div>
                    <h5>Servizi</h5>
                    <ul>
                        <li><a asp-page="/Index" asp-fragment="servizi">Sistemi Informatici</a></li>
                        <li><a asp-page="/Index" asp-fragment="servizi">Helpdesk e Assistenza</a></li>
                        <li><a asp-page="/Index" asp-fragment="servizi">Cybersicurezza</a></li>
                        <li><a asp-page="/Index" asp-fragment="servizi">Consulenza e Formazione</a></li>
                        <li><a asp-page="/Index" asp-fragment="soluzioni-avanzate">Soluzioni Avanzate</a></li>
                        <li><a asp-page="/Index" asp-fragment="tecnoshield">tecnoSHIELD</a></li>
                    </ul>
                </div>
                <div>
                    <h5>Azienda</h5>
                    <ul>
                        <li><a asp-page="/Index" asp-fragment="chi-siamo">Chi siamo</a></li>
                        <li><a asp-page="/Index" asp-fragment="contatti">Contatti</a></li>
                        <li><a asp-page="/Privacy">Privacy Policy</a></li>
                    </ul>
                </div>
                <div>
                    <h5>Contatti</h5>
                    <ul>
                        <li><i class="bi bi-geo-alt me-2"></i>Via Aretina 167/M, 50136 Firenze</li>
                        <li><i class="bi bi-telephone me-2"></i><a href="tel:+390556617008">055 617008</a></li>
                        <li><i class="bi bi-envelope me-2"></i><a href="mailto:info@tecnolink.it">info@tecnolink.it</a></li>
                    </ul>
                </div>
            </div>
            <div class="tk-footer-bottom">
                <span>&copy; @DateTime.Now.Year Tecnolink — P.IVA 04609110483</span>
                <span>Progettato con cura a Firenze</span>
            </div>
        </div>
    </footer>
    }

    <button id="tkBackToTop" class="tk-back-to-top" aria-label="Torna in cima"><i class="bi bi-arrow-up"></i></button>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
