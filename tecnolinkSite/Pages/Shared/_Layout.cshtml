<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tecnolink | Sistemi Informatici &amp; Cybersecurity a Firenze</title>
    <meta name="description" content="Tecnolink: da 20 anni sistemi informatici, sicurezza informatica e servizi di data science su misura per aziende e professionisti a Firenze. Scopri tecnoSHIELD." />
    <link rel="icon" href="~/favicon.ico" />
    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="tk-progress" id="tkProgress"></div>
    <nav class="tk-nav" id="tkNav">
        <div class="container-xl">
            <a class="tk-brand" asp-area="" asp-page="/Index">
                <img src="~/img/logo-tecnolink-bianco-180x51.png" alt="Tecnolink" class="tk-logo" />
            </a>

            <ul class="tk-nav-links">
                <li><a asp-page="/Index" asp-fragment="home">Home</a></li>
                <li><a asp-page="/Index" asp-fragment="servizi">Servizi</a></li>
                <li><a asp-page="/Index" asp-fragment="tecnoshield">tecnoSHIELD</a></li>
                <li><a asp-page="/Index" asp-fragment="chi-siamo">Chi siamo</a></li>
                <li><a asp-page="/Index" asp-fragment="contatti">Contatti</a></li>
                <li class="d-lg-none"><a class="btn-tk btn-tk-primary" asp-page="/Index" asp-fragment="contatti">Richiedi Consulenza</a></li>
            </ul>

            <div class="tk-nav-actions">
                <a class="tk-nav-phone d-none d-lg-flex" href="tel:+390556617008"><i class="bi bi-telephone-fill"></i> 055 617008</a>
                <a class="btn-tk btn-tk-primary" asp-page="/Index" asp-fragment="contatti">Richiedi Consulenza</a>
                <button class="tk-nav-toggle" id="tkNavToggle" aria-label="Apri menu"><i class="bi bi-list"></i></button>
            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="tk-footer">
        <div class="container-xl">
            <div class="tk-footer-grid">
                <div>
                    <a class="tk-brand" asp-area="" asp-page="/Index" style="margin-bottom:1rem;">
                        <img src="~/img/logo-tecnolink-bianco-180x51.png" alt="Tecnolink" class="tk-logo" />
                    </a>
                    <p>Da 20 anni progettiamo sistemi informatici e soluzioni di sicurezza su misura, senza chiedere ai nostri clienti di scegliere tra privacy e sicurezza.</p>
                    <div class="tk-social">
                        <a href="tel:+390556617008" aria-label="Telefono"><i class="bi bi-telephone"></i></a>
                        <a href="mailto:info@tecnolink.it" aria-label="Email"><i class="bi bi-envelope"></i></a>
                        <a href="https://www.linkedin.com" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>
                <div>
                    <h5>Servizi</h5>
                    <ul>
                        <li><a asp-page="/Index" asp-fragment="servizi">Sistemi Informatici</a></li>
                        <li><a asp-page="/Index" asp-fragment="servizi">Sicurezza Informatica</a></li>
                        <li><a asp-page="/Index" asp-fragment="servizi">Data Science</a></li>
                        <li><a asp-page="/Index" asp-fragment="tecnoshield">tecnoSHIELD</a></li>
                    </ul>
                </div>
                <div>
                    <h5>Azienda</h5>
                    <ul>
                        <li><a asp-page="/Index" asp-fragment="chi-siamo">Chi siamo</a></li>
                        <li><a asp-page="/Index" asp-fragment="contatti">Contatti</a></li>
                        <li><a asp-page="/Privacy">Privacy Policy</a></li>
                    </ul>
                </div>
                <div>
                    <h5>Contatti</h5>
                    <ul>
                        <li><i class="bi bi-geo-alt me-2"></i>Via Aretina 167/M, 50136 Firenze</li>
                        <li><i class="bi bi-telephone me-2"></i><a href="tel:+390556617008">055 617008</a></li>
                        <li><i class="bi bi-envelope me-2"></i><a href="mailto:info@tecnolink.it">info@tecnolink.it</a></li>
                    </ul>
                </div>
            </div>
            <div class="tk-footer-bottom">
                <span>&copy; @DateTime.Now.Year Tecnolink — P.IVA 04609110483</span>
                <span>Progettato con cura a Firenze</span>
            </div>
        </div>
    </footer>

    <button id="tkBackToTop" class="tk-back-to-top" aria-label="Torna in cima"><i class="bi bi-arrow-up"></i></button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
