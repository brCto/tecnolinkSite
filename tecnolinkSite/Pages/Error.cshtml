@page "{statusCode:int?}"
@model ErrorModel
@{
    ViewData["Title"] = Model.ErrorStatusCode == 404 ? "Pagina non trovata" : "Si è verificato un errore";
    ViewData["Description"] = "La pagina richiesta non è disponibile. Torna alla home di Tecnolink o contattaci per assistenza.";
    ViewData["Robots"] = "noindex, follow";
}

<section class="tk-hero" style="padding:10rem 0 6rem; min-height:70vh; display:flex; align-items:center;">
    <div class="container-xl">
        <div style="max-width:38rem; margin:0 auto; text-align:center; position:relative; z-index:1;">
            <div style="font-family:var(--font-head); font-weight:700; font-size:clamp(4rem,12vw,7rem); line-height:1; margin-bottom:1rem;" class="gradient-text">
                @(Model.ErrorStatusCode == 404 ? "404" : Model.ErrorStatusCode.ToString())
            </div>

            @if (Model.ErrorStatusCode == 404)
            {
                <h1 style="color:#fff;">Questa pagina si è persa nella rete.</h1>
                <p class="lead" style="margin-left:auto;margin-right:auto;">L'indirizzo che hai seguito non esiste o è stato spostato. Nel frattempo, la tua sicurezza informatica resta la nostra priorità: torniamo a occuparcene insieme.</p>
            }
            else
            {
                <h1 style="color:#fff;">Si è verificato un errore imprevisto.</h1>
                <p class="lead" style="margin-left:auto;margin-right:auto;">Il nostro team è già al lavoro. Riprova tra qualche istante o contattaci se il problema persiste.</p>
            }

            <div class="tk-hero-cta" style="justify-content:center;">
                <a href="/" class="btn-tk btn-tk-primary"><i class="bi bi-house-door"></i> Torna alla Home</a>
                <a href="/#contatti" class="btn-tk btn-tk-ghost"><i class="bi bi-headset"></i> Contatta l'assistenza</a>
            </div>

            @if (Model.ShowRequestId)
            {
                <p style="margin-top:2.5rem; color:rgba(255,255,255,0.4); font-size:0.8rem;">
                    Codice riferimento: <code style="color:rgba(255,255,255,0.55); background:rgba(255,255,255,0.08); padding:0.15rem 0.5rem; border-radius:4px;">@Model.RequestId</code>
                </p>
            }
        </div>
    </div>
</section>
