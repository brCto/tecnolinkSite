    <div class="container-xl">
        <div class="tk-about-grid">
            <div class="tk-about-visual reveal">
                <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=900&q=80" alt="Il team Tecnolink al lavoro" loading="lazy" width="900" height="1125" />
                <div class="years-badge">
                    <div class="n">20+</div>
                    <div class="t">Anni</div>
                </div>
            </div>
            <div class="reveal">
                <span class="eyebrow">Chi siamo</span>
                <h2>Tecnolink si fa in tre</h2>
