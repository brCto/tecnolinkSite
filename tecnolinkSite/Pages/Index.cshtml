@page
@model IndexModel
@{
    ViewData["Title"] = "Sistemi Informatici e Cybersecurity a Firenze";
    ViewData["Description"] = "Tecnolink: da 20 anni sistemi informatici, helpdesk, cybersicurezza e consulenza IT su misura per aziende e professionisti a Firenze e zone limitrofe. Scopri tecnoSHIELD.";
}

<!-- ============================== HERO ============================== -->
<section class="tk-hero" id="home">
    <canvas id="tkHeroCanvas" class="tk-hero-canvas"></canvas>
    <div class="container-xl">
        <div class="tk-hero-grid">
            <div>
                <span class="tk-hero-badge"><i class="bi bi-shield-check"></i> 20 anni di esperienza a Firenze</span>
                <h1>La sicurezza informatica <span class="gradient-text">su misura</span>, senza compromessi tra privacy e sicurezza.</h1>
                <p class="lead">Progettiamo sistemi informatici, protezione cyber e soluzioni data science pensate sulle esigenze reali della tua azienda. Non ti chiediamo di scegliere: ti offriamo il meglio di entrambi.</p>
                <div class="tk-hero-cta">
                    <a href="#contatti" class="btn-tk btn-tk-primary"><i class="bi bi-calendar-check"></i> Richiedi una Consulenza Gratuita</a>
                    <a href="#tecnoshield" class="btn-tk btn-tk-ghost"><i class="bi bi-shield-lock"></i> Scopri tecnoSHIELD</a>
                </div>
                <div class="tk-hero-trust">
                    <div><strong>20+</strong> Anni di esperienza</div>
                    <div><strong>24/7</strong> Monitoraggio continuo</div>
                    <div><strong>100%</strong> Soluzioni su misura</div>
                </div>
            </div>
            <div class="tk-hero-visual">
                <div class="frame">
                    <img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&w=1200&q=80" alt="Specialista Tecnolink al lavoro su sistemi di sicurezza informatica" loading="eager" />
                </div>
                <div class="tk-float-card card-top">
                    <div class="icon-wrap"><i class="bi bi-hdd-network"></i></div>
                    <div>
                        <div class="label">Backup Monitor</div>
                        <div class="value">Sempre protetti</div>
                    </div>
                </div>
                <div class="tk-float-card card-bottom">
                    <div class="icon-wrap"><i class="bi bi-shield-check"></i></div>
                    <div>
                        <div class="label">Check Sicurezza</div>
                        <div class="value">Zero pensieri</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================== STATS ============================== -->
<section class="tk-stats">
    <div class="container-xl">
        <div class="tk-stats-grid">
            <div class="reveal">
                <div class="num"><span class="counter" data-target="20" data-suffix="+">0</span></div>
                <div class="label">Anni di esperienza</div>
            </div>
            <div class="reveal">
                <div class="num"><span>24/7</span></div>
                <div class="label">Monitoraggio continuo</div>
            </div>
            <div class="reveal">
                <div class="num"><span class="counter" data-target="4" data-suffix="">0</span></div>
                <div class="label">Aree di competenza</div>
            </div>
            <div class="reveal">
                <div class="num"><span class="counter" data-target="100" data-suffix="%">0</span></div>
                <div class="label">Servizi personalizzati</div>
            </div>
        </div>
    </div>
</section>

<!-- ============================== SERVIZI ============================== -->
<section class="tk-section" id="servizi">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">I nostri servizi</span>
            <h2>Soluzioni IT pensate per la tua azienda</h2>
            <p>Consulenza, progettazione e fornitura di sistemi informatici per aziende e professionisti che gestiscono dati sensibili, con un occhio sempre attento alla sicurezza e all'efficienza. Operiamo a Firenze e nelle zone limitrofe.</p>
        </div>

        <div class="tk-services-grid cols-4">
            <div class="tk-service-card compact reveal">
                <div class="icon-wrap"><i class="bi bi-diagram-3"></i></div>
                <h3>Sistemi Informatici</h3>
                <p>Consulenza, progettazione e fornitura di sistemi informatici su misura per aziende e professionisti.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Progettazione su misura</li>
                    <li><i class="bi bi-check-circle-fill"></i> Fornitura e installazione apparati</li>
                    <li><i class="bi bi-check-circle-fill"></i> Monitoraggio continuo</li>
                </ul>
            </div>
            <div class="tk-service-card compact reveal">
                <div class="icon-wrap"><i class="bi bi-headset"></i></div>
                <h3>Helpdesk e Assistenza Tecnica</h3>
                <p>Un punto di riferimento sempre raggiungibile per risolvere ogni imprevisto tecnico, in sede o da remoto.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Assistenza rapida e diretta</li>
                    <li><i class="bi bi-check-circle-fill"></i> Supporto in sede e da remoto</li>
                    <li><i class="bi bi-check-circle-fill"></i> Tecnici sempre disponibili</li>
                </ul>
            </div>
            <div class="tk-service-card compact reveal">
                <div class="icon-wrap"><i class="bi bi-shield-lock"></i></div>
                <h3>Cybersicurezza</h3>
                <p>Soluzioni di protezione proattiva per affrontare un panorama di minacce in continua evoluzione.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Protezione proattiva, non reattiva</li>
                    <li><i class="bi bi-check-circle-fill"></i> Strumentazione all'avanguardia</li>
                    <li><i class="bi bi-check-circle-fill"></i> Tranquillità garantita</li>
                </ul>
            </div>
            <div class="tk-service-card compact reveal">
                <div class="icon-wrap"><i class="bi bi-mortarboard"></i></div>
                <h3>Consulenza e Formazione</h3>
                <p>Affianchiamo aziende e professionisti nelle scelte tecnologiche e formiamo i team a un uso sicuro degli strumenti digitali.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Consulenza strategica IT</li>
                    <li><i class="bi bi-check-circle-fill"></i> Formazione del personale</li>
                    <li><i class="bi bi-check-circle-fill"></i> Soluzioni personalizzate</li>
                </ul>
            </div>
        </div>

        <div class="tk-feature-grid" style="margin-top:1.75rem;">
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-cloud-arrow-up"></i></div>
                <div>
                    <h4>Backup Monitor</h4>
                    <p>Monitoraggio continuo per mantenere sempre efficiente il backup e prevenire ogni perdita di dati.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-search"></i></div>
                <div>
                    <h4>Check Sicurezza</h4>
                    <p>Controllo e manutenzione della sicurezza informatica svolti da operatori esperti, giorno dopo giorno.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-cpu"></i></div>
                <div>
                    <h4>Verifica Hardware</h4>
                    <p>Diagnostica periodica dell'hardware con strumenti sempre aggiornati, per anticipare ogni guasto.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================== SOLUZIONI AVANZATE ============================== -->
<section class="tk-section bg-soft" id="soluzioni-avanzate">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">Per aziende strutturate</span>
            <h2>Soluzioni avanzate per la sicurezza aziendale</h2>
            <p>Oltre ai servizi di base, affianchiamo le aziende con soluzioni pensate per team distribuiti, dispositivi da mettere in sicurezza e progetti su misura.</p>
        </div>

        <div class="tk-feature-grid cols-2">
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-laptop"></i></div>
                <div>
                    <h4>Gestione Dispositivi Aziendali</h4>
                    <p>Sicurezza e gestione centralizzata dei dispositivi in dotazione ai dipendenti, ovunque si trovino.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-router"></i></div>
                <div>
                    <h4>VPN e Lavoro da Remoto</h4>
                    <p>Strutture VPN e sistemi per la gestione sicura delle connessioni dei collaboratori in smart working.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-bug"></i></div>
                <div>
                    <h4>Vulnerability Assessment</h4>
                    <p>Audit di sicurezza e analisi delle vulnerabilità per individuare i punti deboli prima che vengano sfruttati.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-eraser"></i></div>
                <div>
                    <h4>Analisi e Bonifica Dispositivi</h4>
                    <p>Individuazione e rimozione di minacce dai dispositivi aziendali, con verifica approfondita dello stato di sicurezza.</p>
                </div>
            </div>
        </div>

        <div class="tk-highlight-card reveal">
            <div class="icon-wrap"><i class="bi bi-code-slash"></i></div>
            <div class="content">
                <h3>Sviluppo Progetti su Richiesta</h3>
                <p>Ogni azienda ha esigenze diverse: sviluppiamo integrazioni su misura tra i tuoi strumenti gestionali e le tecnologie più recenti.</p>
                <ul class="tk-example-tags">
                    <li><i class="bi bi-stars"></i> Integrazione gestionali e database con intelligenza artificiale</li>
                    <li><i class="bi bi-vector-pen"></i> Integrazione del gestionale con la firma digitale</li>
                </ul>
            </div>
        </div>
    </div>
</section>

