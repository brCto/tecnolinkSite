@page "/interno/materiali-campagne"
@{
    ViewData["Title"] = "Materiali campagne (uso interno)";
    ViewData["Description"] = "Indice interno dei creativi e dei documenti delle campagne a pagamento.";
    ViewData["Robots"] = "noindex, nofollow";
}

@functions {
    // Nome leggibile delle quattro varianti grafiche, in ordine di quanto la
    // fotografia invade il testo.
    static string NomeVariante(string v) => v switch
    {
        "bn" => "Bianco e nero — nessuna foto",
        "foto" => "Foto a tutto fondo — massimo impatto, il testo ci sta sopra",
        "fascia" => "Foto in fascia — nessuna sovrapposizione, testo su nero",
        "riquadro" => "Foto in riquadro — la più composta, sembra una pagina",
        _ => v,
    };

    // I quattro concetti dei manifesti, per pubblico: il nome del file e come
    // apre il discorso. Stesso ordine del generatore.
    static (string Nome, string Come)[] Manifesti(string pubblico) => pubblico == "aziende"
        ? new[]
        {
            ("domanda", "Una domanda a cui non si sa rispondere"),
            ("nis2", "La distinzione che sposta il problema"),
            ("esito", "Il risultato, senza nominare la minaccia"),
            ("questionario", "La pressione che arriva da fuori"),
        }
        : new[]
        {
            ("wifi", "Una domanda a cui non si sa rispondere"),
            ("router", "Un fatto scomodo, detto piano"),
            ("esito", "Il risultato, senza nominare la minaccia"),
            ("telecamere", "L'abitudine che crea il problema"),
        };
}

@*
    Pagina di servizio, non commerciale: è l'indice da cui si ritrovano i creativi
    delle campagne senza doverli cercare nel repository. I PNG stanno in
    wwwroot/img/campagne/ perché è da qui che vengono mostrati; i sorgenti che li
    generano stanno in docs/creativi/, indicati sotto ogni sezione.

    noindex, nofollow: non deve finire nei motori di ricerca. Non è protetta da
    password — chi conosce l'indirizzo la vede, come i PNG che mostra. Sono
    creativi pubblicitari destinati a diventare pubblici, quindi va bene così;
    se un giorno ci finisse dentro materiale riservato, serve una vera protezione.
*@

