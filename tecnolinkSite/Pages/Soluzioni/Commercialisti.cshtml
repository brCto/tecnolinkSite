@page "/soluzioni/commercialisti"
@{
    ViewData["Title"] = "Sicurezza Informatica per Commercialisti e Studi Contabili";
    ViewData["Description"] = "Protezione di bilanci, dichiarazioni e dati fiscali per commercialisti e studi contabili di Firenze e zone limitrofe: scopri le soluzioni Tecnolink dedicate.";
    ViewData["Robots"] = "noindex, follow";
}

<section class="tk-hero" id="home" style="padding-bottom:5rem;">
    <div class="container-xl">
        <div class="tk-hero-grid">
            <div>
                <span class="tk-hero-badge"><i class="bi bi-calculator"></i> Soluzioni dedicate a Commercialisti e Studi Contabili</span>
                <h1>Bilanci, dichiarazioni, dati fiscali: <span class="gradient-text">al sicuro sempre</span>.</h1>
                <p class="lead">Dati fiscali dei clienti, scadenze non rinviabili, fatturazione elettronica e PEC: lo studio contabile non può permettersi fermi o perdite di dati. Tecnolink protegge il tuo studio con soluzioni pensate per la continuità, soprattutto nei periodi di scadenza.</p>
                <div class="tk-hero-cta">
                    <a href="#contatti" class="btn-tk btn-tk-primary"><i class="bi bi-calendar-check"></i> Richiedi una Consulenza Dedicata</a>
                    <a href="tel:+390556617008" class="btn-tk btn-tk-ghost"><i class="bi bi-telephone-fill"></i> 055 617008</a>
                </div>
                <div class="tk-hero-trust">
                    <div><strong>20+</strong> Anni di esperienza</div>
                    <div><strong>24/7</strong> Monitoraggio continuo</div>
                    <div><strong>100%</strong> Continuità nelle scadenze</div>
                </div>
            </div>
            <div class="tk-hero-visual">
                <div class="frame">
                    <img src="https://images.unsplash.com/photo-1554224155-6726b3ff858f?auto=format&fit=crop&w=1200&q=80" alt="Sicurezza informatica per studi commercialisti" />
                </div>
                <div class="tk-float-card card-top">
                    <div class="icon-wrap"><i class="bi bi-file-earmark-bar-graph"></i></div>
                    <div>
                        <div class="label">Bilanci e dati fiscali</div>
                        <div class="value">Sempre protetti</div>
                    </div>
                </div>
                <div class="tk-float-card card-bottom">
                    <div class="icon-wrap"><i class="bi bi-envelope-check"></i></div>
                    <div>
                        <div class="label">PEC &amp; Fatturazione</div>
                        <div class="value">In sicurezza</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="tk-section">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">Le sfide dello studio contabile</span>
            <h2>Ciò che rischi senza una protezione adeguata</h2>
        </div>
        <div class="tk-feature-grid">
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-exclamation-triangle"></i></div>
                <div>
                    <h4>Dati fiscali dei clienti esposti</h4>
                    <p>Bilanci, dichiarazioni e dati contabili sono informazioni sensibili che richiedono una protezione rigorosa.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-clock-history"></i></div>
                <div>
                    <h4>Fermo nei periodi di scadenza</h4>
                    <p>Un sistema bloccato a ridosso di una scadenza fiscale ha conseguenze dirette su tutti i tuoi clienti.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-hdd-network"></i></div>
                <div>
                    <h4>Perdita di documentazione contabile</h4>
                    <p>Senza un backup monitorato, anni di bilanci, dichiarazioni e pratiche possono andare persi in pochi minuti.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="tk-section bg-soft">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">La soluzione</span>
            <h2>Come proteggiamo il tuo studio</h2>
        </div>
        <div class="tk-services-grid">
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-shield-lock"></i></div>
                <h3>tecnoSHIELD per Studi Contabili</h3>
                <p>Un piano di sicurezza su misura per proteggere dati fiscali, PEC e fatturazione elettronica da accessi non autorizzati.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Protezione dei dati fiscali dei clienti</li>
                    <li><i class="bi bi-check-circle-fill"></i> Sicurezza di PEC e fatturazione elettronica</li>
                    <li><i class="bi bi-check-circle-fill"></i> Prevenzione orientata, non reattiva</li>
                </ul>
            </div>
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-cloud-arrow-up"></i></div>
                <h3>Backup Monitor</h3>
                <p>Monitoraggio continuo delle copie di sicurezza di bilanci e dichiarazioni, per non perdere mai un documento.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Controllo quotidiano dell'integrità</li>
                    <li><i class="bi bi-check-circle-fill"></i> Interventi tempestivi in caso di anomalie</li>
                    <li><i class="bi bi-check-circle-fill"></i> Continuità durante le scadenze fiscali</li>
                </ul>
            </div>
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-diagram-3"></i></div>
                <h3>Sistemi Informatici su misura</h3>
                <p>Progettazione e manutenzione di postazioni e reti pensate per lo studio contabile, anche in smart working.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Continuità operativa</li>
                    <li><i class="bi bi-check-circle-fill"></i> Accesso sicuro anche da remoto</li>
                    <li><i class="bi bi-check-circle-fill"></i> Assistenza dedicata</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="tk-section">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">Nel dettaglio</span>
            <h2>Servizi pensati per studi legali e commercialisti</h2>
            <p>Le esigenze quotidiane di uno studio professionale richiedono soluzioni specifiche: ecco cosa mettiamo in campo.</p>
        </div>
        <div class="tk-feature-grid">
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-layers"></i></div>
                <div>
                    <h4>Backup e Archivio Storico Multilivello</h4>
                    <p>Soluzione di backup e archivio storico su più livelli, separata per singolo professionista dello studio.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-envelope-paper"></i></div>
                <div>
                    <h4>Gestione Specifica della PEC</h4>
                    <p>Configurazione e gestione dedicata della Posta Elettronica Certificata dello studio, in totale sicurezza.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-share"></i></div>
                <div>
                    <h4>Condivisione Sicura della Connettività</h4>
                    <p>Soluzioni per condividere la connettività di studio tra i professionisti in modo sicuro e controllato.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-vector-pen"></i></div>
                <div>
                    <h4>Acquisizione Firma Digitale</h4>
                    <p>Supporto nell'acquisizione e nella gestione degli strumenti di firma digitale per atti e documenti.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-wifi"></i></div>
                <div>
                    <h4>Wi-Fi di Studio Sicuro</h4>
                    <p>Realizzazione di reti Wi-Fi dedicate allo studio, protette e separate da eventuali reti per gli ospiti.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-key-fill"></i></div>
                <div>
                    <h4>Accesso Remoto tramite VPN</h4>
                    <p>Soluzioni di accesso da remoto ai sistemi di studio tramite VPN sicure, dedicate ai collaboratori.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="tk-section" style="padding-top:0;">
    <div class="container-xl">
        <blockquote class="tk-quote reveal" style="font-size:1.3rem;text-align:center;border-left:none;border-top:3px solid var(--violet-500);padding:1.5rem 2rem 0;max-width:44rem;margin:0 auto;">
            "Non chiediamo ai nostri clienti di scegliere tra privacy o sicurezza. Noi offriamo loro il meglio di entrambi."
        </blockquote>
    </div>
</section>

<section class="tk-section bg-soft" id="contatti">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">Contatti</span>
            <h2>Parliamo delle esigenze del tuo studio</h2>
            <p>Raccontaci la tua situazione: ti proponiamo una soluzione dedicata, senza impegno.</p>
        </div>
        <div style="max-width:36rem;margin:0 auto;">
            <form class="tk-form reveal" id="tkContactForm" data-source="Commercialisti">
                <input type="text" name="hp_field" class="tk-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
                <div class="tk-form-row">
                    <div>
                        <label for="nome">Nome e cognome</label>
                        <input type="text" id="nome" name="nome" placeholder="Dott. Mario Rossi" required />
                    </div>
                    <div>
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" placeholder="studio@email.it" required />
                    </div>
                </div>
                <label for="azienda">Studio</label>
                <input type="text" id="azienda" name="azienda" placeholder="Nome dello studio" />
                <label for="messaggio">Messaggio</label>
                <textarea id="messaggio" name="messaggio" rows="4" placeholder="Raccontaci le esigenze del tuo studio..." required></textarea>
                <button type="submit" class="btn-tk btn-tk-dark" style="width:100%;"><i class="bi bi-send"></i> Invia richiesta</button>
                <div id="tk-form-success" class="mt-3" style="color:var(--success);font-weight:600;"><i class="bi bi-check-circle-fill"></i> Grazie! Ti contatteremo al più presto.</div>
                <div class="tk-form-error" id="tk-form-error">Si è verificato un problema nell'invio. Riprova oppure chiamaci al 055 617008.</div>
            </form>
        </div>
    </div>
</section>
