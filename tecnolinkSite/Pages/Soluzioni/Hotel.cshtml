@page "/soluzioni/hotel"
@{
    ViewData["Title"] = "Sicurezza Informatica per Hotel e Strutture Ricettive";
}

<section class="tk-hero" id="home" style="padding-bottom:5rem;">
    <div class="container-xl">
        <div class="tk-hero-grid">
            <div>
                <span class="tk-hero-badge"><i class="bi bi-building"></i> Soluzioni dedicate a Hotel e Strutture Ricettive</span>
                <h1>Ospiti, prenotazioni e Wi-Fi: <span class="gradient-text">una rete davvero sicura</span>.</h1>
                <p class="lead">Dati degli ospiti, pagamenti, prenotazioni online e una rete Wi-Fi aperta al pubblico: nelle strutture ricettive la superficie di rischio è ampia. Tecnolink protegge la tua struttura separando in sicurezza la rete ospiti da quella gestionale.</p>
                <div class="tk-hero-cta">
                    <a href="#contatti" class="btn-tk btn-tk-primary"><i class="bi bi-calendar-check"></i> Richiedi una Consulenza Dedicata</a>
                    <a href="tel:+390556617008" class="btn-tk btn-tk-ghost"><i class="bi bi-telephone-fill"></i> 055 617008</a>
                </div>
                <div class="tk-hero-trust">
                    <div><strong>20+</strong> Anni di esperienza</div>
                    <div><strong>24/7</strong> Monitoraggio continuo</div>
                    <div><strong>100%</strong> Rete ospiti separata</div>
                </div>
            </div>
            <div class="tk-hero-visual">
                <div class="frame">
                    <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80" alt="Sicurezza informatica per hotel e strutture ricettive" />
                </div>
                <div class="tk-float-card card-top">
                    <div class="icon-wrap"><i class="bi bi-wifi"></i></div>
                    <div>
                        <div class="label">Wi-Fi ospiti</div>
                        <div class="value">Rete separata</div>
                    </div>
                </div>
                <div class="tk-float-card card-bottom">
                    <div class="icon-wrap"><i class="bi bi-calendar2-check"></i></div>
                    <div>
                        <div class="label">Prenotazioni</div>
                        <div class="value">Sempre protette</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="tk-section">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">Le sfide della struttura ricettiva</span>
            <h2>Ciò che rischi senza una protezione adeguata</h2>
        </div>
        <div class="tk-feature-grid">
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-exclamation-triangle"></i></div>
                <div>
                    <h4>Rete ospiti e gestionale non separate</h4>
                    <p>Un Wi-Fi pubblico condiviso con i sistemi interni può diventare un punto d'accesso per chi vuole colpire i tuoi dati.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-clock-history"></i></div>
                <div>
                    <h4>Fermo del sistema prenotazioni</h4>
                    <p>Un blocco del PMS durante il check-in o l'alta stagione si traduce in disservizi e recensioni negative.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-hdd-network"></i></div>
                <div>
                    <h4>Perdita dei dati degli ospiti</h4>
                    <p>Senza un backup monitorato, anagrafiche, prenotazioni e dati di pagamento possono andare persi irrimediabilmente.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="tk-section bg-soft">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">La soluzione</span>
            <h2>Come proteggiamo la tua struttura</h2>
        </div>
        <div class="tk-services-grid">
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-shield-lock"></i></div>
                <h3>tecnoSHIELD per l'Hospitality</h3>
                <p>Un piano di sicurezza su misura che separa la rete ospiti da quella gestionale, proteggendo dati e sistemi di prenotazione.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Segmentazione delle reti Wi-Fi</li>
                    <li><i class="bi bi-check-circle-fill"></i> Protezione dei dati degli ospiti</li>
                    <li><i class="bi bi-check-circle-fill"></i> Prevenzione orientata, non reattiva</li>
                </ul>
            </div>
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-cloud-arrow-up"></i></div>
                <h3>Backup Monitor</h3>
                <p>Monitoraggio continuo dei dati di prenotazione e fatturazione, per non fermare mai l'accoglienza.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Controllo quotidiano dell'integrità</li>
                    <li><i class="bi bi-check-circle-fill"></i> Interventi tempestivi in caso di anomalie</li>
                    <li><i class="bi bi-check-circle-fill"></i> Continuità durante l'alta stagione</li>
                </ul>
            </div>
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-diagram-3"></i></div>
                <h3>Sistemi Informatici su misura</h3>
                <p>Progettazione e manutenzione della rete tra reception, camere e aree comuni, in totale sicurezza.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Rete unificata e sicura</li>
                    <li><i class="bi bi-check-circle-fill"></i> Verifica periodica dell'hardware</li>
                    <li><i class="bi bi-check-circle-fill"></i> Assistenza dedicata</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="tk-section" style="padding-top:0;">
    <div class="container-xl">
        <blockquote class="tk-quote reveal" style="font-size:1.3rem;text-align:center;border-left:none;border-top:3px solid var(--violet-500);padding:1.5rem 2rem 0;max-width:44rem;margin:0 auto;">
            "Non chiediamo ai nostri clienti di scegliere tra privacy o sicurezza. Noi offriamo loro il meglio di entrambi."
        </blockquote>
    </div>
</section>

<section class="tk-section bg-soft" id="contatti">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">Contatti</span>
            <h2>Parliamo delle esigenze della tua struttura</h2>
            <p>Raccontaci la tua situazione: ti proponiamo una soluzione dedicata, senza impegno.</p>
        </div>
        <div style="max-width:36rem;margin:0 auto;">
            <form class="tk-form reveal" id="tkContactForm">
                <div class="tk-form-row">
                    <div>
                        <label for="nome">Nome e cognome</label>
                        <input type="text" id="nome" name="nome" placeholder="Mario Rossi" required />
                    </div>
                    <div>
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" placeholder="hotel@email.it" required />
                    </div>
                </div>
                <label for="azienda">Struttura</label>
                <input type="text" id="azienda" name="azienda" placeholder="Nome della struttura" />
                <label for="messaggio">Messaggio</label>
                <textarea id="messaggio" name="messaggio" rows="4" placeholder="Raccontaci le esigenze della tua struttura..." required></textarea>
                <button type="submit" class="btn-tk btn-tk-dark" style="width:100%;"><i class="bi bi-send"></i> Invia richiesta</button>
                <div id="tk-form-success" class="mt-3" style="color:var(--success);font-weight:600;"><i class="bi bi-check-circle-fill"></i> Grazie! Ti contatteremo al più presto.</div>
            </form>
        </div>
    </div>
</section>
