@page "/soluzioni/studi-medici"
@{
    ViewData["Title"] = "Sicurezza Informatica per Studi Medici e Sanità";
    ViewData["Description"] = "Protezione dei dati sanitari e delle cartelle cliniche per studi medici e strutture sanitarie di Firenze e zone limitrofe: scopri le soluzioni Tecnolink dedicate.";
    ViewData["Robots"] = "noindex, follow";
}

<section class="tk-hero" id="home" style="padding-bottom:5rem;">
    <div class="container-xl">
        <div class="tk-hero-grid">
            <div>
                <span class="tk-hero-badge"><i class="bi bi-heart-pulse"></i> Soluzioni dedicate a Studi Medici e Sanità</span>
                <h1>I dati dei tuoi pazienti meritano <span class="gradient-text">la massima protezione</span>.</h1>
                <p class="lead">Cartelle cliniche, referti, dati sanitari: si tratta di informazioni particolarmente sensibili, con obblighi di tutela ancora più stringenti. Tecnolink protegge lo studio medico o la struttura sanitaria con soluzioni pensate per chi gestisce dati che non ammettono compromessi.</p>
                <div class="tk-hero-cta">
                    <a href="#contatti" class="btn-tk btn-tk-primary"><i class="bi bi-calendar-check"></i> Richiedi una Consulenza Dedicata</a>
                    <a href="tel:+39055617008" class="btn-tk btn-tk-ghost"><i class="bi bi-telephone-fill"></i> 055 617008</a>
                </div>
                <div class="tk-hero-trust">
                    <div><strong>24/7</strong> Monitoraggio continuo</div>
                    <div><strong>100%</strong> Dati sanitari protetti</div>
                </div>
            </div>
            <div class="tk-hero-visual">
                <div class="frame">
                    <img src="https://images.unsplash.com/photo-1666214280391-8ff5bd3c0bf0?auto=format&fit=crop&w=1200&q=80" alt="Sicurezza informatica per studi medici" />
                </div>
                <div class="tk-float-card card-top">
                    <div class="icon-wrap"><i class="bi bi-file-earmark-medical"></i></div>
                    <div>
                        <div class="label">Cartelle cliniche</div>
                        <div class="value">Sempre al sicuro</div>
                    </div>
                </div>
                <div class="tk-float-card card-bottom">
                    <div class="icon-wrap"><i class="bi bi-shield-check"></i></div>
                    <div>
                        <div class="label">Dati sanitari</div>
                        <div class="value">Protetti</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="tk-section">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">Le sfide dello studio medico</span>
            <h2>Ciò che rischi senza una protezione adeguata</h2>
        </div>
        <div class="tk-feature-grid">
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-exclamation-triangle"></i></div>
                <div>
                    <h4>Dati sanitari particolarmente sensibili</h4>
                    <p>Le informazioni sulla salute dei pazienti richiedono un livello di tutela superiore rispetto ai dati comuni.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-clock-history"></i></div>
                <div>
                    <h4>Continuità dell'attività clinica</h4>
                    <p>Un sistema bloccato durante le visite o gli appuntamenti compromette il servizio verso i pazienti.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-hdd-network"></i></div>
                <div>
                    <h4>Perdita di cartelle cliniche</h4>
                    <p>Senza un backup monitorato, anni di storico clinico dei pazienti possono andare persi irrimediabilmente.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="tk-section bg-soft">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">La soluzione</span>
            <h2>Come proteggiamo il tuo studio</h2>
        </div>
        <div class="tk-services-grid">
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-shield-lock"></i></div>
                <h3>tecnoSHIELD per la Sanità</h3>
                <p>Un piano di sicurezza su misura per proteggere cartelle cliniche, referti e dati dei pazienti da accessi non autorizzati.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Protezione dei dati sanitari</li>
                    <li><i class="bi bi-check-circle-fill"></i> Sicurezza dei dispositivi in rete</li>
                    <li><i class="bi bi-check-circle-fill"></i> Prevenzione orientata, non reattiva</li>
                </ul>
            </div>
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-cloud-arrow-up"></i></div>
                <h3>Backup Monitor</h3>
                <p>Monitoraggio continuo delle copie di sicurezza delle cartelle cliniche, per non perdere mai lo storico dei pazienti.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Controllo quotidiano dell'integrità</li>
                    <li><i class="bi bi-check-circle-fill"></i> Interventi tempestivi in caso di anomalie</li>
                    <li><i class="bi bi-check-circle-fill"></i> Tranquillità nella gestione clinica</li>
                </ul>
            </div>
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-diagram-3"></i></div>
                <h3>Sistemi Informatici su misura</h3>
                <p>Progettazione e manutenzione di postazioni e dispositivi diagnostici in rete, in totale sicurezza.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Continuità operativa dello studio</li>
                    <li><i class="bi bi-check-circle-fill"></i> Verifica periodica dell'hardware</li>
                    <li><i class="bi bi-check-circle-fill"></i> Assistenza dedicata</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="tk-section" style="padding-top:0;">
    <div class="container-xl">
        <blockquote class="tk-quote reveal" style="font-size:1.3rem;text-align:center;border-left:none;border-top:3px solid var(--violet-500);padding:1.5rem 2rem 0;max-width:44rem;margin:0 auto;">
            "Non chiediamo ai nostri clienti di scegliere tra privacy o sicurezza. Noi offriamo loro il meglio di entrambi."
        </blockquote>
    </div>
</section>

<section class="tk-section bg-soft" id="contatti">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">Contatti</span>
            <h2>Parliamo delle esigenze del tuo studio</h2>
            <p>Raccontaci la tua situazione: ti proponiamo una soluzione dedicata, senza impegno.</p>
        </div>
        <div style="max-width:36rem;margin:0 auto;">
            <form class="tk-form reveal" id="tkContactForm" data-source="Studi Medici">
                <input type="text" name="hp_field" class="tk-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
                <div class="tk-form-row">
                    <div>
                        <label for="nome">Nome e cognome</label>
                        <input type="text" id="nome" name="nome" placeholder="Dott. Mario Rossi" required />
                    </div>
                    <div>
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" placeholder="studio@email.it" required />
                    </div>
                </div>
                <label for="azienda">Studio / Struttura</label>
                <input type="text" id="azienda" name="azienda" placeholder="Nome dello studio o struttura" />
                <label for="messaggio">Messaggio</label>
                <textarea id="messaggio" name="messaggio" rows="4" placeholder="Raccontaci le esigenze del tuo studio..." required></textarea>
                <button type="submit" class="btn-tk btn-tk-dark" style="width:100%;"><i class="bi bi-send"></i> Invia richiesta</button>
                <div id="tk-form-success" class="mt-3" style="color:var(--success);font-weight:600;"><i class="bi bi-check-circle-fill"></i> Grazie! Ti contatteremo al più presto.</div>
                <div class="tk-form-error" id="tk-form-error">Si è verificato un problema nell'invio. Riprova oppure chiamaci al 055 617008.</div>
            </form>
        </div>
    </div>
</section>
