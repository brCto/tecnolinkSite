@page "/soluzioni/farmacie"
@{
    ViewData["Title"] = "Sicurezza Informatica per Farmacie";
    ViewData["Description"] = "Protezione di ricette elettroniche, dati sanitari e sistemi di cassa per le farmacie di Firenze e zone limitrofe: scopri le soluzioni Tecnolink dedicate al settore.";
    ViewData["Robots"] = "noindex, follow";
}

<section class="tk-hero" id="home" style="padding-bottom:5rem;">
    <div class="container-xl">
        <div class="tk-hero-grid">
            <div>
                <span class="tk-hero-badge"><i class="bi bi-capsule"></i> Soluzioni dedicate alle Farmacie</span>
                <h1>Ricette, dati sanitari e cassa: <span class="gradient-text">un'unica rete protetta</span>.</h1>
                <p class="lead">Ricette elettroniche, dati sanitari dei pazienti, magazzino e cassa sempre connessi: la farmacia non può permettersi fermi o violazioni. Tecnolink protegge ogni punto della tua rete, dal banco alla farmacia dei servizi.</p>
                <div class="tk-hero-cta">
                    <a href="#contatti" class="btn-tk btn-tk-primary"><i class="bi bi-calendar-check"></i> Richiedi una Consulenza Dedicata</a>
                    <a href="tel:+390556617008" class="btn-tk btn-tk-ghost"><i class="bi bi-telephone-fill"></i> 055 617008</a>
                </div>
                <div class="tk-hero-trust">
                    <div><strong>20+</strong> Anni di esperienza</div>
                    <div><strong>24/7</strong> Monitoraggio continuo</div>
                    <div><strong>100%</strong> Continuità del servizio</div>
                </div>
            </div>
            <div class="tk-hero-visual">
                <div class="frame">
                    <img src="https://images.unsplash.com/photo-1586015555751-63bb77f4322a?auto=format&fit=crop&w=1200&q=80" alt="Sicurezza informatica per farmacie" />
                </div>
                <div class="tk-float-card card-top">
                    <div class="icon-wrap"><i class="bi bi-file-earmark-medical"></i></div>
                    <div>
                        <div class="label">Ricette elettroniche</div>
                        <div class="value">Sempre protette</div>
                    </div>
                </div>
                <div class="tk-float-card card-bottom">
                    <div class="icon-wrap"><i class="bi bi-cart-check"></i></div>
                    <div>
                        <div class="label">Cassa &amp; Magazzino</div>
                        <div class="value">Zero fermi</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="tk-section">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">Le sfide della farmacia</span>
            <h2>Ciò che rischi senza una protezione adeguata</h2>
        </div>
        <div class="tk-feature-grid">
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-exclamation-triangle"></i></div>
                <div>
                    <h4>Dati sanitari dei pazienti</h4>
                    <p>Le ricette elettroniche e lo storico degli acquisti sono dati particolarmente sensibili da tutelare con attenzione.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-clock-history"></i></div>
                <div>
                    <h4>Fermo del servizio al pubblico</h4>
                    <p>Un blocco della cassa o del gestionale durante l'orario di apertura interrompe un servizio essenziale per il territorio.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-hdd-network"></i></div>
                <div>
                    <h4>Perdita dei dati di magazzino</h4>
                    <p>Senza un backup monitorato, la gestione di scorte, ordini e scadenze dei farmaci può andare persa in pochi minuti.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="tk-section bg-soft">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">La soluzione</span>
            <h2>Come proteggiamo la tua farmacia</h2>
        </div>
        <div class="tk-services-grid">
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-shield-lock"></i></div>
                <h3>tecnoSHIELD per Farmacie</h3>
                <p>Un piano di sicurezza su misura per proteggere ricette elettroniche, dati dei pazienti e servizi digitali della farmacia.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Protezione dei dati sanitari</li>
                    <li><i class="bi bi-check-circle-fill"></i> Sicurezza dei servizi in farmacia</li>
                    <li><i class="bi bi-check-circle-fill"></i> Prevenzione orientata, non reattiva</li>
                </ul>
            </div>
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-cloud-arrow-up"></i></div>
                <h3>Backup Monitor</h3>
                <p>Monitoraggio continuo dei dati di cassa, magazzino e scadenze, per non fermare mai il servizio al pubblico.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Controllo quotidiano dell'integrità</li>
                    <li><i class="bi bi-check-circle-fill"></i> Interventi tempestivi in caso di anomalie</li>
                    <li><i class="bi bi-check-circle-fill"></i> Continuità del servizio al banco</li>
                </ul>
            </div>
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-diagram-3"></i></div>
                <h3>Sistemi Informatici su misura</h3>
                <p>Progettazione e manutenzione della rete tra cassa, magazzino e postazioni per i servizi al cliente.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Rete unificata e sicura</li>
                    <li><i class="bi bi-check-circle-fill"></i> Verifica periodica dell'hardware</li>
                    <li><i class="bi bi-check-circle-fill"></i> Assistenza dedicata</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="tk-section" style="padding-top:0;">
    <div class="container-xl">
        <blockquote class="tk-quote reveal" style="font-size:1.3rem;text-align:center;border-left:none;border-top:3px solid var(--violet-500);padding:1.5rem 2rem 0;max-width:44rem;margin:0 auto;">
            "Non chiediamo ai nostri clienti di scegliere tra privacy o sicurezza. Noi offriamo loro il meglio di entrambi."
        </blockquote>
    </div>
</section>

<section class="tk-section bg-soft" id="contatti">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">Contatti</span>
            <h2>Parliamo delle esigenze della tua farmacia</h2>
            <p>Raccontaci la tua situazione: ti proponiamo una soluzione dedicata, senza impegno.</p>
        </div>
        <div style="max-width:36rem;margin:0 auto;">
            <form class="tk-form reveal" id="tkContactForm" data-source="Farmacie">
                <input type="text" name="hp_field" class="tk-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
                <div class="tk-form-row">
                    <div>
                        <label for="nome">Nome e cognome</label>
                        <input type="text" id="nome" name="nome" placeholder="Dott.ssa Maria Rossi" required />
                    </div>
                    <div>
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" placeholder="farmacia@email.it" required />
                    </div>
                </div>
                <label for="azienda">Farmacia</label>
                <input type="text" id="azienda" name="azienda" placeholder="Nome della farmacia" />
                <label for="messaggio">Messaggio</label>
                <textarea id="messaggio" name="messaggio" rows="4" placeholder="Raccontaci le esigenze della tua farmacia..." required></textarea>
                <button type="submit" class="btn-tk btn-tk-dark" style="width:100%;"><i class="bi bi-send"></i> Invia richiesta</button>
                <div id="tk-form-success" class="mt-3" style="color:var(--success);font-weight:600;"><i class="bi bi-check-circle-fill"></i> Grazie! Ti contatteremo al più presto.</div>
                <div class="tk-form-error" id="tk-form-error">Si è verificato un problema nell'invio. Riprova oppure chiamaci al 055 617008.</div>
            </form>
        </div>
    </div>
</section>
