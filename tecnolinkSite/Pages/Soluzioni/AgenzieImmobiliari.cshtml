@page "/soluzioni/agenzie-immobiliari"
@{
    ViewData["Title"] = "Sicurezza Informatica per Agenzie Immobiliari";
    ViewData["Description"] = "Protezione del CRM, dei contratti e dei dati dei clienti per le agenzie immobiliari: scopri le soluzioni Tecnolink dedicate al settore.";
    ViewData["Robots"] = "noindex, follow";
}

<section class="tk-hero" id="home" style="padding-bottom:5rem;">
    <div class="container-xl">
        <div class="tk-hero-grid">
            <div>
                <span class="tk-hero-badge"><i class="bi bi-house-door"></i> Soluzioni dedicate alle Agenzie Immobiliari</span>
                <h1>CRM, contratti e caparre: <span class="gradient-text">protetti ad ogni passaggio</span>.</h1>
                <p class="lead">Dati di acquirenti e venditori, documentazione contrattuale, caparre e pagamenti: l'agenzia immobiliare gestisce informazioni delicate lungo tutta la trattativa. Tecnolink protegge il tuo CRM e le tue postazioni, in agenzia e sul territorio.</p>
                <div class="tk-hero-cta">
                    <a href="#contatti" class="btn-tk btn-tk-primary"><i class="bi bi-calendar-check"></i> Richiedi una Consulenza Dedicata</a>
                    <a href="tel:+390556617008" class="btn-tk btn-tk-ghost"><i class="bi bi-telephone-fill"></i> 055 617008</a>
                </div>
                <div class="tk-hero-trust">
                    <div><strong>20+</strong> Anni di esperienza</div>
                    <div><strong>24/7</strong> Monitoraggio continuo</div>
                    <div><strong>100%</strong> Soluzioni multi-agenzia</div>
                </div>
            </div>
            <div class="tk-hero-visual">
                <div class="frame">
                    <img src="https://images.unsplash.com/photo-1560518883-ce09059eeffa?auto=format&fit=crop&w=1200&q=80" alt="Sicurezza informatica per agenzie immobiliari" />
                </div>
                <div class="tk-float-card card-top">
                    <div class="icon-wrap"><i class="bi bi-person-vcard"></i></div>
                    <div>
                        <div class="label">CRM clienti</div>
                        <div class="value">Sempre protetto</div>
                    </div>
                </div>
                <div class="tk-float-card card-bottom">
                    <div class="icon-wrap"><i class="bi bi-file-earmark-text"></i></div>
                    <div>
                        <div class="label">Contratti</div>
                        <div class="value">In sicurezza</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="tk-section">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">Le sfide dell'agenzia immobiliare</span>
            <h2>Ciò che rischi senza una protezione adeguata</h2>
        </div>
        <div class="tk-feature-grid">
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-exclamation-triangle"></i></div>
                <div>
                    <h4>Dati di acquirenti e venditori esposti</h4>
                    <p>Anagrafiche, documenti e dettagli delle trattative sono informazioni sensibili che richiedono una protezione rigorosa.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-diagram-2"></i></div>
                <div>
                    <h4>Agenti e sedi sul territorio</h4>
                    <p>Postazioni distribuite tra sede e agenti sul campo aumentano i punti di accesso da mettere in sicurezza.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-hdd-network"></i></div>
                <div>
                    <h4>Fermo del CRM in trattativa</h4>
                    <p>Un blocco del gestionale durante una trattativa delicata può compromettere la fiducia del cliente.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="tk-section bg-soft">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">La soluzione</span>
            <h2>Come proteggiamo la tua agenzia</h2>
        </div>
        <div class="tk-services-grid">
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-shield-lock"></i></div>
                <h3>tecnoSHIELD per il Settore Immobiliare</h3>
                <p>Un piano di sicurezza su misura per proteggere CRM, contratti e dati dei clienti lungo tutta la trattativa.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Protezione dei dati di acquirenti e venditori</li>
                    <li><i class="bi bi-check-circle-fill"></i> Sicurezza su più sedi e agenti</li>
                    <li><i class="bi bi-check-circle-fill"></i> Prevenzione orientata, non reattiva</li>
                </ul>
            </div>
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-cloud-arrow-up"></i></div>
                <h3>Backup Monitor</h3>
                <p>Monitoraggio continuo del CRM e dei documenti contrattuali, per non perdere mai una trattativa in corso.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Controllo quotidiano dell'integrità</li>
                    <li><i class="bi bi-check-circle-fill"></i> Interventi tempestivi in caso di anomalie</li>
                    <li><i class="bi bi-check-circle-fill"></i> Continuità durante le trattative</li>
                </ul>
            </div>
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-diagram-3"></i></div>
                <h3>Sistemi Informatici su misura</h3>
                <p>Progettazione e manutenzione della rete tra sede, agenti sul territorio e strumenti di lavoro mobile.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Accesso sicuro anche fuori sede</li>
                    <li><i class="bi bi-check-circle-fill"></i> Rete unificata e sicura</li>
                    <li><i class="bi bi-check-circle-fill"></i> Assistenza dedicata</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="tk-section" style="padding-top:0;">
    <div class="container-xl">
        <blockquote class="tk-quote reveal" style="font-size:1.3rem;text-align:center;border-left:none;border-top:3px solid var(--violet-500);padding:1.5rem 2rem 0;max-width:44rem;margin:0 auto;">
            "Non chiediamo ai nostri clienti di scegliere tra privacy o sicurezza. Noi offriamo loro il meglio di entrambi."
        </blockquote>
    </div>
</section>

<section class="tk-section bg-soft" id="contatti">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">Contatti</span>
            <h2>Parliamo delle esigenze della tua agenzia</h2>
            <p>Raccontaci la tua situazione: ti proponiamo una soluzione dedicata, senza impegno.</p>
        </div>
        <div style="max-width:36rem;margin:0 auto;">
            <form class="tk-form reveal" id="tkContactForm">
                <div class="tk-form-row">
                    <div>
                        <label for="nome">Nome e cognome</label>
                        <input type="text" id="nome" name="nome" placeholder="Mario Rossi" required />
                    </div>
                    <div>
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" placeholder="agenzia@email.it" required />
                    </div>
                </div>
                <label for="azienda">Agenzia</label>
                <input type="text" id="azienda" name="azienda" placeholder="Nome dell'agenzia" />
                <label for="messaggio">Messaggio</label>
                <textarea id="messaggio" name="messaggio" rows="4" placeholder="Raccontaci le esigenze della tua agenzia..." required></textarea>
                <button type="submit" class="btn-tk btn-tk-dark" style="width:100%;"><i class="bi bi-send"></i> Invia richiesta</button>
                <div id="tk-form-success" class="mt-3" style="color:var(--success);font-weight:600;"><i class="bi bi-check-circle-fill"></i> Grazie! Ti contatteremo al più presto.</div>
            </form>
        </div>
    </div>
</section>
