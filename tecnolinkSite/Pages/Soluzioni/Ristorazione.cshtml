@page "/soluzioni/ristorazione"
@{
    ViewData["Title"] = "Sicurezza Informatica per Ristoranti e Catene di Ristorazione";
    ViewData["Description"] = "Protezione di cassa, prenotazioni e programmi fedeltà per ristoranti e catene di ristorazione multi-sede: soluzioni Tecnolink dedicate, a Firenze e zone limitrofe.";
    ViewData["Robots"] = "noindex, follow";
}

<section class="tk-hero" id="home" style="padding-bottom:5rem;">
    <div class="container-xl">
        <div class="tk-hero-grid">
            <div>
                <span class="tk-hero-badge"><i class="bi bi-cup-hot"></i> Soluzioni dedicate a Ristoranti e Catene</span>
                <h1>Cassa, prenotazioni e fidelity: <span class="gradient-text">protetti in ogni sede</span>.</h1>
                <p class="lead">Sistemi di cassa, prenotazioni online, programmi fedeltà con i dati dei clienti: nella ristorazione un fermo nel momento di punta si traduce subito in un disservizio visibile. Tecnolink protegge la tua rete, sede per sede.</p>
                <div class="tk-hero-cta">
                    <a href="#contatti" class="btn-tk btn-tk-primary"><i class="bi bi-calendar-check"></i> Richiedi una Consulenza Dedicata</a>
                    <a href="tel:+39055617008" class="btn-tk btn-tk-ghost"><i class="bi bi-telephone-fill"></i> 055 617008</a>
                </div>
                <div class="tk-hero-trust">
                    <div><strong>24/7</strong> Monitoraggio continuo</div>
                    <div><strong>100%</strong> Soluzioni multi-sede</div>
                </div>
            </div>
            <div class="tk-hero-visual">
                <div class="frame">
                    <img src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1200&q=80" alt="Sicurezza informatica per ristoranti e catene di ristorazione" />
                </div>
                <div class="tk-float-card card-top">
                    <div class="icon-wrap"><i class="bi bi-receipt"></i></div>
                    <div>
                        <div class="label">Cassa &amp; POS</div>
                        <div class="value">Zero fermi</div>
                    </div>
                </div>
                <div class="tk-float-card card-bottom">
                    <div class="icon-wrap"><i class="bi bi-star"></i></div>
                    <div>
                        <div class="label">Programma fedeltà</div>
                        <div class="value">Protetto</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="tk-section">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">Le sfide della ristorazione</span>
            <h2>Ciò che rischi senza una protezione adeguata</h2>
        </div>
        <div class="tk-feature-grid">
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-exclamation-triangle"></i></div>
                <div>
                    <h4>Fermo cassa nei momenti di punta</h4>
                    <p>Un blocco del sistema POS durante il servizio pranzo o cena crea disagio immediato a clienti e personale.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-diagram-2"></i></div>
                <div>
                    <h4>Reti multi-sede da coordinare</h4>
                    <p>Ogni locale della catena è un punto di accesso: senza una regia unica, un punto debole mette a rischio tutti gli altri.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-hdd-network"></i></div>
                <div>
                    <h4>Perdita dei dati fedeltà e prenotazioni</h4>
                    <p>Senza un backup monitorato, dati clienti, punti fedeltà e prenotazioni possono andare persi in pochi minuti.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="tk-section bg-soft">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">La soluzione</span>
            <h2>Come proteggiamo la tua attività</h2>
        </div>
        <div class="tk-services-grid">
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-shield-lock"></i></div>
                <h3>tecnoSHIELD per la Ristorazione</h3>
                <p>Un piano di sicurezza su misura per proteggere cassa, prenotazioni e programma fedeltà in ogni sede.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Protezione dei sistemi di cassa</li>
                    <li><i class="bi bi-check-circle-fill"></i> Sicurezza su più locali</li>
                    <li><i class="bi bi-check-circle-fill"></i> Prevenzione orientata, non reattiva</li>
                </ul>
            </div>
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-diagram-3"></i></div>
                <h3>Sistemi Informatici su misura</h3>
                <p>Progettazione e manutenzione della rete cassa multi-sede, con hardware sempre verificato e assistenza rapida.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Rete unificata e sicura</li>
                    <li><i class="bi bi-check-circle-fill"></i> Verifica periodica dell'hardware</li>
                    <li><i class="bi bi-check-circle-fill"></i> Assistenza dedicata</li>
                </ul>
            </div>
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-cloud-arrow-up"></i></div>
                <h3>Backup Monitor</h3>
                <p>Monitoraggio continuo di dati vendite e programma fedeltà, per non fermare mai il servizio in sala.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Controllo quotidiano dell'integrità</li>
                    <li><i class="bi bi-check-circle-fill"></i> Interventi tempestivi in caso di anomalie</li>
                    <li><i class="bi bi-check-circle-fill"></i> Continuità nei momenti di punta</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="tk-section" style="padding-top:0;">
    <div class="container-xl">
        <blockquote class="tk-quote reveal" style="font-size:1.3rem;text-align:center;border-left:none;border-top:3px solid var(--violet-500);padding:1.5rem 2rem 0;max-width:44rem;margin:0 auto;">
            "Non chiediamo ai nostri clienti di scegliere tra privacy o sicurezza. Noi offriamo loro il meglio di entrambi."
        </blockquote>
    </div>
</section>

<section class="tk-section bg-soft" id="contatti">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">Contatti</span>
            <h2>Parliamo delle esigenze della tua attività</h2>
            <p>Raccontaci la tua situazione: ti proponiamo una soluzione dedicata, senza impegno.</p>
        </div>
        <div style="max-width:36rem;margin:0 auto;">
            <form class="tk-form reveal" id="tkContactForm" data-source="Ristorazione">
                <input type="text" name="hp_field" class="tk-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
                <div class="tk-form-row">
                    <div>
                        <label for="nome">Nome e cognome</label>
                        <input type="text" id="nome" name="nome" placeholder="Mario Rossi" required />
                    </div>
                    <div>
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" placeholder="ristorante@email.it" required />
                    </div>
                </div>
                <label for="azienda">Locale / Catena</label>
                <input type="text" id="azienda" name="azienda" placeholder="Nome del locale o della catena" />
                <label for="messaggio">Messaggio</label>
                <textarea id="messaggio" name="messaggio" rows="4" placeholder="Raccontaci le esigenze della tua attività..." required></textarea>
                <button type="submit" class="btn-tk btn-tk-dark" style="width:100%;"><i class="bi bi-send"></i> Invia richiesta</button>
                <div id="tk-form-success" class="mt-3" style="color:var(--success);font-weight:600;"><i class="bi bi-check-circle-fill"></i> Grazie! Ti contatteremo al più presto.</div>
                <div class="tk-form-error" id="tk-form-error">Si è verificato un problema nell'invio. Riprova oppure chiamaci al 055 617008.</div>
            </form>
        </div>
    </div>
</section>
