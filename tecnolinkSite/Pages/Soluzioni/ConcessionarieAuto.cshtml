@page "/soluzioni/concessionarie-auto"
@{
    ViewData["Title"] = "Sicurezza Informatica per Concessionarie Auto";
    ViewData["Description"] = "Protezione di showroom, officina e gestionale vendite per le concessionarie auto: scopri le soluzioni Tecnolink dedicate al settore.";
    ViewData["Robots"] = "noindex, follow";
}

<section class="tk-hero" id="home" style="padding-bottom:5rem;">
    <div class="container-xl">
        <div class="tk-hero-grid">
            <div>
                <span class="tk-hero-badge"><i class="bi bi-car-front"></i> Soluzioni dedicate alle Concessionarie Auto</span>
                <h1>Showroom, officina e gestionale: <span class="gradient-text">protetti insieme</span>.</h1>
                <p class="lead">Anagrafiche clienti, pratiche di finanziamento, gestionali di vendita e sistemi in officina: nelle concessionarie i dati sensibili viaggiano su più sedi e più reparti. Tecnolink mette in sicurezza ogni punto della tua rete, dalla sala esposizione al reparto assistenza.</p>
                <div class="tk-hero-cta">
                    <a href="#contatti" class="btn-tk btn-tk-primary"><i class="bi bi-calendar-check"></i> Richiedi una Consulenza Dedicata</a>
                    <a href="tel:+390556617008" class="btn-tk btn-tk-ghost"><i class="bi bi-telephone-fill"></i> 055 617008</a>
                </div>
                <div class="tk-hero-trust">
                    <div><strong>20+</strong> Anni di esperienza</div>
                    <div><strong>24/7</strong> Monitoraggio continuo</div>
                    <div><strong>100%</strong> Soluzioni multi-sede</div>
                </div>
            </div>
            <div class="tk-hero-visual">
                <div class="frame">
                    <img src="https://images.unsplash.com/photo-1562911791-c7a97b729ec5?auto=format&fit=crop&w=1200&q=80" alt="Sicurezza informatica per concessionarie auto" />
                </div>
                <div class="tk-float-card card-top">
                    <div class="icon-wrap"><i class="bi bi-clipboard-data"></i></div>
                    <div>
                        <div class="label">Gestionale vendite</div>
                        <div class="value">Sempre protetto</div>
                    </div>
                </div>
                <div class="tk-float-card card-bottom">
                    <div class="icon-wrap"><i class="bi bi-camera-video"></i></div>
                    <div>
                        <div class="label">Rete showroom</div>
                        <div class="value">Sotto controllo</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="tk-section">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">Le sfide della concessionaria</span>
            <h2>Ciò che rischi senza una protezione adeguata</h2>
        </div>
        <div class="tk-feature-grid">
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-exclamation-triangle"></i></div>
                <div>
                    <h4>Dati clienti e finanziamenti esposti</h4>
                    <p>Anagrafiche, documenti e pratiche di finanziamento sono dati sensibili che richiedono una protezione rigorosa.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-diagram-2"></i></div>
                <div>
                    <h4>Reti multi-sede e multi-reparto</h4>
                    <p>Showroom, ufficio amministrativo e officina spesso condividono la stessa rete: un punto debole mette a rischio tutto.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-hdd-network"></i></div>
                <div>
                    <h4>Fermo del gestionale in campagna</h4>
                    <p>Un blocco del sistema durante una promozione o una campagna commerciale si traduce in vendite perse.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="tk-section bg-soft">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">La soluzione</span>
            <h2>Come proteggiamo la tua concessionaria</h2>
        </div>
        <div class="tk-services-grid">
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-shield-lock"></i></div>
                <h3>tecnoSHIELD per Concessionarie</h3>
                <p>Un piano di sicurezza pensato per showroom, officina e amministrazione, con un unico referente per tutta la rete aziendale.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Protezione dei dati clienti e finanziamenti</li>
                    <li><i class="bi bi-check-circle-fill"></i> Sicurezza su più sedi e reparti</li>
                    <li><i class="bi bi-check-circle-fill"></i> Prevenzione orientata, non reattiva</li>
                </ul>
            </div>
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-cloud-arrow-up"></i></div>
                <h3>Backup Monitor</h3>
                <p>Monitoraggio continuo del gestionale di vendita e dei dati amministrativi, per non fermare mai l'attività.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Controllo quotidiano dell'integrità</li>
                    <li><i class="bi bi-check-circle-fill"></i> Interventi tempestivi in caso di anomalie</li>
                    <li><i class="bi bi-check-circle-fill"></i> Continuità durante le campagne vendita</li>
                </ul>
            </div>
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-diagram-3"></i></div>
                <h3>Sistemi Informatici su misura</h3>
                <p>Progettazione e manutenzione della rete tra showroom, uffici e officina, con hardware sempre verificato.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Verifica periodica dell'hardware</li>
                    <li><i class="bi bi-check-circle-fill"></i> Rete unificata e sicura</li>
                    <li><i class="bi bi-check-circle-fill"></i> Assistenza dedicata</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="tk-section" style="padding-top:0;">
    <div class="container-xl">
        <blockquote class="tk-quote reveal" style="font-size:1.3rem;text-align:center;border-left:none;border-top:3px solid var(--violet-500);padding:1.5rem 2rem 0;max-width:44rem;margin:0 auto;">
            "Non chiediamo ai nostri clienti di scegliere tra privacy o sicurezza. Noi offriamo loro il meglio di entrambi."
        </blockquote>
    </div>
</section>

<section class="tk-section bg-soft" id="contatti">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">Contatti</span>
            <h2>Parliamo delle esigenze della tua concessionaria</h2>
            <p>Raccontaci la tua situazione: ti proponiamo una soluzione dedicata, senza impegno.</p>
        </div>
        <div style="max-width:36rem;margin:0 auto;">
            <form class="tk-form reveal" id="tkContactForm">
                <div class="tk-form-row">
                    <div>
                        <label for="nome">Nome e cognome</label>
                        <input type="text" id="nome" name="nome" placeholder="Mario Rossi" required />
                    </div>
                    <div>
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" placeholder="concessionaria@email.it" required />
                    </div>
                </div>
                <label for="azienda">Concessionaria</label>
                <input type="text" id="azienda" name="azienda" placeholder="Nome della concessionaria" />
                <label for="messaggio">Messaggio</label>
                <textarea id="messaggio" name="messaggio" rows="4" placeholder="Raccontaci le esigenze della tua concessionaria..." required></textarea>
                <button type="submit" class="btn-tk btn-tk-dark" style="width:100%;"><i class="bi bi-send"></i> Invia richiesta</button>
                <div id="tk-form-success" class="mt-3" style="color:var(--success);font-weight:600;"><i class="bi bi-check-circle-fill"></i> Grazie! Ti contatteremo al più presto.</div>
            </form>
        </div>
    </div>
</section>
