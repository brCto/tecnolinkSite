@page "/soluzioni/e-commerce"
@{
    ViewData["Title"] = "Sicurezza Informatica per E-commerce";
    ViewData["Description"] = "Protezione dei dati di pagamento e continuità della piattaforma di vendita online: scopri le soluzioni Tecnolink dedicate all'e-commerce a Firenze e zone limitrofe.";
    ViewData["Robots"] = "noindex, follow";
}

<section class="tk-hero" id="home" style="padding-bottom:5rem;">
    <div class="container-xl">
        <div class="tk-hero-grid">
            <div>
                <span class="tk-hero-badge"><i class="bi bi-bag-check"></i> Soluzioni dedicate all'E-commerce</span>
                <h1>Il tuo negozio online <span class="gradient-text">non può fermarsi mai</span>.</h1>
                <p class="lead">Dati di pagamento, catalogo, ordini: ogni minuto di fermo del sito è una vendita persa, e ogni picco di traffico è un potenziale bersaglio. Tecnolink protegge la tua piattaforma di vendita online con un monitoraggio continuo e su misura.</p>
                <div class="tk-hero-cta">
                    <a href="#contatti" class="btn-tk btn-tk-primary"><i class="bi bi-calendar-check"></i> Richiedi una Consulenza Dedicata</a>
                    <a href="tel:+39055617008" class="btn-tk btn-tk-ghost"><i class="bi bi-telephone-fill"></i> 055 617008</a>
                </div>
                <div class="tk-hero-trust">
                    <div><strong>24/7</strong> Monitoraggio continuo</div>
                    <div><strong>100%</strong> Protezione nei picchi di traffico</div>
                </div>
            </div>
            <div class="tk-hero-visual">
                <div class="frame">
                    <img src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=1200&q=80" alt="Sicurezza informatica per e-commerce" />
                </div>
                <div class="tk-float-card card-top">
                    <div class="icon-wrap"><i class="bi bi-credit-card"></i></div>
                    <div>
                        <div class="label">Pagamenti</div>
                        <div class="value">Sempre protetti</div>
                    </div>
                </div>
                <div class="tk-float-card card-bottom">
                    <div class="icon-wrap"><i class="bi bi-graph-up-arrow"></i></div>
                    <div>
                        <div class="label">Picchi di traffico</div>
                        <div class="value">Sotto controllo</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="tk-section">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">Le sfide dell'e-commerce</span>
            <h2>Ciò che rischi senza una protezione adeguata</h2>
        </div>
        <div class="tk-feature-grid">
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-exclamation-triangle"></i></div>
                <div>
                    <h4>Dati di pagamento esposti</h4>
                    <p>Un negozio online gestisce dati di carte e transazioni: un incidente di sicurezza mina la fiducia dei clienti.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-clock-history"></i></div>
                <div>
                    <h4>Fermo del sito nei momenti chiave</h4>
                    <p>Un blocco della piattaforma durante saldi o campagne promozionali significa vendite perse in tempo reale.</p>
                </div>
            </div>
            <div class="tk-feature-card reveal">
                <div class="icon-wrap"><i class="bi bi-hdd-network"></i></div>
                <div>
                    <h4>Perdita di catalogo e ordini</h4>
                    <p>Senza un backup monitorato, catalogo prodotti, ordini e dati clienti possono andare persi in pochi minuti.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="tk-section bg-soft">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">La soluzione</span>
            <h2>Come proteggiamo il tuo negozio online</h2>
        </div>
        <div class="tk-services-grid">
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-shield-lock"></i></div>
                <h3>tecnoSHIELD per l'E-commerce</h3>
                <p>Un piano di sicurezza su misura per proteggere la piattaforma di vendita, i dati di pagamento e la reputazione online.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Protezione dei dati di pagamento</li>
                    <li><i class="bi bi-check-circle-fill"></i> Sicurezza nei picchi di traffico</li>
                    <li><i class="bi bi-check-circle-fill"></i> Prevenzione orientata, non reattiva</li>
                </ul>
            </div>
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-search"></i></div>
                <h3>Check Sicurezza</h3>
                <p>Controllo e manutenzione continua della sicurezza della piattaforma, svolti da operatori esperti.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Monitoraggio continuo del sito</li>
                    <li><i class="bi bi-check-circle-fill"></i> Interventi tempestivi in caso di anomalie</li>
                    <li><i class="bi bi-check-circle-fill"></i> Continuità durante le campagne di vendita</li>
                </ul>
            </div>
            <div class="tk-service-card reveal">
                <div class="icon-wrap"><i class="bi bi-cloud-arrow-up"></i></div>
                <h3>Backup Monitor</h3>
                <p>Monitoraggio continuo di catalogo, ordini e dati clienti, per non perdere mai una vendita.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Controllo quotidiano dell'integrità</li>
                    <li><i class="bi bi-check-circle-fill"></i> Copie di sicurezza sempre aggiornate</li>
                    <li><i class="bi bi-check-circle-fill"></i> Assistenza dedicata</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="tk-section" style="padding-top:0;">
    <div class="container-xl">
        <blockquote class="tk-quote reveal" style="font-size:1.3rem;text-align:center;border-left:none;border-top:3px solid var(--violet-500);padding:1.5rem 2rem 0;max-width:44rem;margin:0 auto;">
            "Non chiediamo ai nostri clienti di scegliere tra privacy o sicurezza. Noi offriamo loro il meglio di entrambi."
        </blockquote>
    </div>
</section>

<section class="tk-section bg-soft" id="contatti">
    <div class="container-xl">
        <div class="tk-section-head center reveal">
            <span class="eyebrow" style="justify-content:center;">Contatti</span>
            <h2>Parliamo delle esigenze del tuo e-commerce</h2>
            <p>Raccontaci la tua situazione: ti proponiamo una soluzione dedicata, senza impegno.</p>
        </div>
        <div style="max-width:36rem;margin:0 auto;">
            <form class="tk-form reveal" id="tkContactForm" data-source="E-commerce">
                <input type="text" name="hp_field" class="tk-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
                <div class="tk-form-row">
                    <div>
                        <label for="nome">Nome e cognome</label>
                        <input type="text" id="nome" name="nome" placeholder="Mario Rossi" required />
                    </div>
                    <div>
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" placeholder="shop@email.it" required />
                    </div>
                </div>
                <label for="azienda">Negozio online</label>
                <input type="text" id="azienda" name="azienda" placeholder="Nome dell'e-commerce" />
                <label for="messaggio">Messaggio</label>
                <textarea id="messaggio" name="messaggio" rows="4" placeholder="Raccontaci le esigenze del tuo e-commerce..." required></textarea>
                <button type="submit" class="btn-tk btn-tk-dark" style="width:100%;"><i class="bi bi-send"></i> Invia richiesta</button>
                <div id="tk-form-success" class="mt-3" style="color:var(--success);font-weight:600;"><i class="bi bi-check-circle-fill"></i> Grazie! Ti contatteremo al più presto.</div>
                <div class="tk-form-error" id="tk-form-error">Si è verificato un problema nell'invio. Riprova oppure chiamaci al 055 617008.</div>
            </form>
        </div>
    </div>
</section>
